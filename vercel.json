{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix apps/web install && npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/ios",
      "destination": "/ios.html"
    },
    {
      "source": "/((?!api/|ios(\\.html)?$|carved/|img/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/demo/reset",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recipient-status",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/reconcile-pending",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/activation-radar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "10 4 * * *"
    }
  ]
}
