# Racha — environment template. Copy to .env and fill; NEVER commit .env.
# (Regra da casa: sem segredo em código, validação no startup, chave vazada = rotacionada.)

# --- Supabase (projeto: racha / worttfotxasxqjaqwpjf, sa-east-1) -------------
SUPABASE_URL=https://worttfotxasxqjaqwpjf.supabase.co
# Publishable (browser-safe; RLS nega tudo — tabelas são service-role only):
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cID1pB9ptK-9FdXr4MQ_3A_j-clyc9E
# Service role: pegue em Dashboard → Settings → API. NUNCA no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth compartilhada com o Seatable (opcional) ----------------------------
# Verifica o token contra OUTRO projeto Supabase (o do Seatable) — quem já tem
# conta no Seatable loga no Racha, enquanto os DADOS ficam no projeto do Racha.
# Sem estes, a auth cai no projeto do próprio Racha (SUPABASE_URL acima).
# getUser() só verifica o JWT → a chave publicável basta (não é service-role).
# Requer: FK venue_members→auth.users solto (migração 0008) + o FRONTEND apontando
# pro mesmo projeto (VITE_SUPABASE_URL/PUBLISHABLE_KEY = Seatable, na Vercel).
# AUTH_SUPABASE_URL=https://ckforlwdhewexyqljsaf.supabase.co
# AUTH_SUPABASE_KEY=sb_publishable_... (a publicável do Seatable)

# --- PSP ---------------------------------------------------------------------
# mock (dev/demo) | pagarme (DECIDIDO 2026-07-19 — docs/psp/README.md)
RACHA_PSP=mock
# Segredo de assinatura dos webhooks do MOCK (>=16 chars)
PSP_WEBHOOK_SECRET=
# Pagar.me (só com RACHA_PSP=pagarme): sk_test_... em test mode, sk_live_ depois.
# NUNCA no repo/chat — Vercel env ou .env local. Ativação: docs/psp/README.md.
PAGARME_SECRET_KEY=
# Basic Auth do endpoint de webhook (mesmo user:senha configurado no dashboard)
PAGARME_WEBHOOK_AUTH=
# PUBLICÁVEIS (browser-safe, viram bundle do front — mesmo padrão da chave
# publishable do Supabase). Ligam o botão REAL do Google Pay no lugar da
# sheet de demo. pk_test_ roda no environment TEST do Google.
VITE_PAGARME_PUBLIC_KEY=pk_test_P52ZE7h6VF8jvjmy
VITE_PAGARME_ACCOUNT_ID=acc_d4zGpnxtxyFp2DyV
# merchantId do Google (BCR2DN...) do Google Pay & Wallet Console — OBRIGATÓRIO
# no go-live (environment PRODUCTION), dispensável em TEST. NÃO é o acc_ acima.
# Só setar depois de verificar o domínio no console do Google.
VITE_GOOGLE_PAY_MERCHANT_ID=

# --- App ---------------------------------------------------------------------
NODE_ENV=development
# memory (default, demo sem nuvem) | supabase (roda a demo contra o projeto real)
RACHA_STORE=memory
